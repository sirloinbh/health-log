POSTGRES_DB=health
POSTGRES_USER=health
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://health:change-this-local-password@localhost:15403/health
PORT=3103
# Server only (#74, docs/access-protection.md): WEB_BIND=0.0.0.0 and WEB_PORT=8103.
# Leave them unset locally, in .env and in the shell, so the web stays on 127.0.0.1:8103.
