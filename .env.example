POSTGRES_DB=health
POSTGRES_USER=health
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://health:change-this-local-password@localhost:15403/health
PORT=3103
# WEB_BIND and WEB_PORT (#74, docs/access-protection.md): leave them unset locally and on the server,
# so the web stays on 127.0.0.1:8103 and only the shared HTTPS proxy reaches it. Never use 0.0.0.0.
# The shared sign-in (#167): compose sets AUTH_INTERNAL_URL for the API (http://shared-auth-api:3110).
# Leave it unset locally and the API runs without the sign-in; production refuses to start without it.
