POSTGRES_DB=health
POSTGRES_USER=health
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgres://health:change-this-local-password@localhost:15403/health
PORT=3103
# WEB_BIND and WEB_PORT (#74, docs/access-protection.md): leave them unset locally. On the server the first deploy
# (deploy/bootstrap-env.sh) writes 127.0.0.1 and 8103; keep them, so only the shared HTTPS proxy reaches the web.
# Never use 0.0.0.0.
# The shared sign-in (#167): compose sets AUTH_INTERNAL_URL for the API (http://shared-auth-api:3110).
# Leave it unset locally and the API runs without the sign-in; production refuses to start without it.
# shared-ai's Ed25519 public key (PEM, one line with \n escapes). Set: the API serves its AI tools at
# /internal/tools; empty: no tools. The server deploy reads it from SSM. @secret @ssm=/sirloinbh/shared/ai-tools-public-key
AI_TOOLS_PUBLIC_KEY=
# workout-memo's API for the daily screen's workouts (#333). compose defaults it to http://workout-memo-api:3101 on the shared-ai network;
# leave it unset locally and the screen says workout-memo cannot be reached.
WORKOUT_MEMO_URL=
# Public Data Portal auth key (Decoding) for the MFDS food nutrition lookup on the add-food screen (#118). Empty: the
# screen says the lookup is not set up. The server deploy reads it from SSM; locally run tools/app-secrets.mjs pull in
# project-standards or leave it empty. @secret @ssm=/sirloinbh/shared/data-go-kr-service-key
FOOD_NTR_SERVICE_KEY=
