# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Health Log weekly restore check of the newest database dump
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/health-log
ExecStart=/bin/bash -c 'cp /opt/health-log/deploy/backup.sh /tmp/health-restore-check.sh && exec /bin/bash /tmp/health-restore-check.sh verify'
TimeoutStartSec=30min
Nice=10
