# 중앙 관리 파일. 수정은 sirloinbh/project-standards의 templates/app/deploy/에서
[Unit]
Description=식단·수면·건강 기록 weekly restore check of the newest database dump
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/health-log
ExecStart=/bin/bash -c 'cp /opt/health-log/deploy/backup.sh /tmp/health-restore-check.sh && exec /bin/bash /tmp/health-restore-check.sh verify'
TimeoutStartSec=30min
Nice=10
